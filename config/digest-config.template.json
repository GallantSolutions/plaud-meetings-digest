{
  "version": "2.4.1",
  "installed_at": null,
  "platform": null,
  "claude_models": {
    "meetings-digest": { "model": "claude-sonnet-4-6", "fallback": "claude-sonnet-4-6" },
    "weekly-rollup":   { "model": "claude-opus-4-7",   "fallback": "claude-sonnet-4-6" }
  },
  "gallant_heartbeat": {
    "enabled": false,
    "ping_base_url": "https://hc-ping.com",
    "checks": {
      "lunch": null,
      "eod": null,
      "rollup": null,
      "auto_update": null
    }
  },
  "gallant_auto_update": {
    "enabled": true,
    "repo": "GallantSolutions/plaud-meetings-digest",
    "channel": "latest",
    "schedule": { "hour": 3, "minute": 0 },
    "pinned_version": null
  },
  "destination": {
    "type": null,
    "onedrive_folder": null,
    "notion_api_key": null,
    "notion_database_id": null,
    "notion_parent_page_id": null,
    "folder": null
  },
  "meeting_routing": {
    "enabled": true,
    "scan_first_seconds": 30,
    "types": [
      {
        "keyword": "Kingsway Pharma",
        "folder": "Kingsway Pharma",
        "filename_prefix": "KPM",
        "rollup_filename_prefix": "KPR",
        "weekly_subfolders": true,
        "include_in_weekly_rollup": true
      },
      {
        "keyword": "Committee",
        "folder": "Committee",
        "filename_prefix": "CMM",
        "rollup_filename_prefix": "CMR",
        "weekly_subfolders": true,
        "include_in_weekly_rollup": true
      },
      {
        "keyword": "Church",
        "folder": "Church",
        "filename_prefix": "CHM",
        "rollup_filename_prefix": "CHR",
        "weekly_subfolders": true,
        "include_in_weekly_rollup": true
      },
      {
        "keyword": "Personal",
        "folder": "Personal",
        "filename_prefix": "PM",
        "rollup_filename_prefix": "PR",
        "weekly_subfolders": true,
        "include_in_weekly_rollup": true
      }
    ],
    "fallback_folder": "Uncategorized",
    "fallback_filename_prefix": "UN"
  },
  "window_days": 3,
  "timezone": "America/New_York",
  "contexts": [
    "Sales",
    "Operations",
    "Strategic",
    "Compliance",
    "Personal"
  ],
  "default_owner": "me",
  "skip_recordings_under_minutes": 2,
  "dedup": {
    "enabled": true,
    "retention_days": 90
  },
  "weekly_rollup": {
    "enabled": true,
    "include_focus_picks": true,
    "max_focus_picks": 5,
    "carry_over_warn_days": 14,
    "carry_over_loud_days": 21,
    "carry_over_window_days": 30
  },
  "schedule": {
    "lunch": {
      "hour": 11,
      "minute": 0
    },
    "eod": {
      "hour": 16,
      "minute": 0
    },
    "rollup": {
      "day_of_week": 5,
      "hour": 16,
      "minute": 30
    }
  }
}
