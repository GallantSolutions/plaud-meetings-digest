{
  "version": "2.5.0",
  "installed_at": null,
  "platform": null,
  "claude_models": {
    "meetings-digest": { "model": "claude-sonnet-4-6", "fallback": "claude-sonnet-4-6" },
    "weekly-rollup":   { "model": "claude-opus-4-7",   "fallback": "claude-sonnet-4-6" }
  },
  "plaud": {
    "method": "mcp_only",
    "_method_help": "mcp_only = current behavior (Plaud MCP get_note); auto = Playwright primary with MCP fallback; playwright_only = Playwright with no fallback (not recommended for clients). Flip to auto AFTER running playwright_setup.ps1 and verifying selectors against current Plaud UI.",
    "playwright": {
      "behavior": {
        "headless": true,
        "viewport_width": 1280,
        "viewport_height": 800,
        "preferred_export_format": "md"
      },
      "throttle": {
        "navigation_min_s": 8,
        "navigation_max_s": 15,
        "click_min_s": 3,
        "click_max_s": 7,
        "micro_min_s": 1,
        "micro_max_s": 3,
        "page_load_timeout_s": 30,
        "action_timeout_s": 15,
        "max_meetings_per_run": 20,
        "rate_limit_backoff_s": [300, 900, 1800]
      },
      "selectors": {
        "_help": "Defaults are placeholders. Verify against current Plaud UI via: scripts/playwright_setup.ps1 -CodegenMode",
        "login_url": "https://web.plaud.ai/",
        "files_url": "https://web.plaud.ai/files",
        "logged_in_probe": "[data-testid='user-menu']",
        "file_row": "[data-testid='file-row']",
        "file_id_attr": "data-file-id",
        "file_title_in_row": "[data-testid='file-title']",
        "file_recorded_at_in_row": "[data-testid='file-recorded-at']",
        "file_detail_loaded_probe": "[data-testid='file-detail']",
        "export_button": "button:has-text('Export')",
        "export_format_md": "text='Markdown'",
        "export_format_docx": "text='Word'"
      }
    }
  },
  "gallant_heartbeat": {
    "enabled": false,
    "ping_base_url": "https://hc-ping.com",
    "checks": {
      "lunch": null,
      "eod": null,
      "rollup": null,
      "auto_update": null
    }
  },
  "gallant_auto_update": {
    "enabled": true,
    "repo": "GallantSolutions/plaud-meetings-digest",
    "channel": "latest",
    "schedule": { "hour": 3, "minute": 0 },
    "pinned_version": null
  },
  "destination": {
    "type": null,
    "onedrive_folder": null,
    "notion_api_key": null,
    "notion_database_id": null,
    "notion_parent_page_id": null,
    "folder": null
  },
  "meeting_routing": {
    "enabled": true,
    "scan_first_seconds": 30,
    "types": [
      {
        "keyword": "Kingsway Pharma",
        "folder": "Kingsway Pharma",
        "filename_prefix": "KPM",
        "rollup_filename_prefix": "KPR",
        "weekly_subfolders": true,
        "include_in_weekly_rollup": true
      },
      {
        "keyword": "Committee",
        "folder": "Committee",
        "filename_prefix": "CMM",
        "rollup_filename_prefix": "CMR",
        "weekly_subfolders": true,
        "include_in_weekly_rollup": true
      },
      {
        "keyword": "Church",
        "folder": "Church",
        "filename_prefix": "CHM",
        "rollup_filename_prefix": "CHR",
        "weekly_subfolders": true,
        "include_in_weekly_rollup": true
      },
      {
        "keyword": "Personal",
        "folder": "Personal",
        "filename_prefix": "PM",
        "rollup_filename_prefix": "PR",
        "weekly_subfolders": true,
        "include_in_weekly_rollup": true
      }
    ],
    "fallback_folder": "Uncategorized",
    "fallback_filename_prefix": "UN"
  },
  "window_days": 3,
  "timezone": "America/New_York",
  "contexts": [
    "Sales",
    "Operations",
    "Strategic",
    "Compliance",
    "Personal"
  ],
  "default_owner": "me",
  "skip_recordings_under_minutes": 2,
  "dedup": {
    "enabled": true,
    "retention_days": 90
  },
  "weekly_rollup": {
    "enabled": true,
    "include_focus_picks": true,
    "max_focus_picks": 5,
    "carry_over_warn_days": 14,
    "carry_over_loud_days": 21,
    "carry_over_window_days": 30
  },
  "schedule": {
    "lunch": {
      "hour": 11,
      "minute": 0
    },
    "eod": {
      "hour": 16,
      "minute": 0
    },
    "rollup": {
      "day_of_week": 5,
      "hour": 16,
      "minute": 30
    }
  }
}
