Get-ChildItem -Path "$env:LOCALAPPDATA" -Filter "plaud*" -ErrorAction SilentlyContinue | Select-Object FullName
Get-ChildItem -Path "$env:USERPROFILE" -Filter "plaud*" -Recurse -Depth 3 -ErrorAction SilentlyContinue | Select-Object FullName
Get-ChildItem -Path "$env:USERPROFILE\.claude" -Recurse -Depth 3 -ErrorAction SilentlyContinue | Where-Object { $_.Name -like "*plaud*" -or $_.Name -like "*meetings*" } | Select-Object FullName
