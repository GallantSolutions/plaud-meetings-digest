$cfgPath = "$HOME\.claude.json"
if (-not (Test-Path $cfgPath)) {
    Write-Host "Creating fresh ~/.claude.json"
    '{}' | Out-File $cfgPath -Encoding utf8 -NoNewline
}
$json = Get-Content $cfgPath -Raw | ConvertFrom-Json
if (-not $json.mcpServers) {
    $json | Add-Member -NotePropertyName mcpServers -NotePropertyValue (New-Object PSObject) -Force
}
$plaudEntry = [PSCustomObject]@{
    command = "npx"
    args    = @("-y", "@plaud-ai/mcp@latest")
}
$json.mcpServers | Add-Member -NotePropertyName plaud -NotePropertyValue $plaudEntry -Force
$jsonOut = $json | ConvertTo-Json -Depth 10
[System.IO.File]::WriteAllText($cfgPath, $jsonOut, [System.Text.UTF8Encoding]::new($false))
Write-Host "--- saved. verifying ---"
